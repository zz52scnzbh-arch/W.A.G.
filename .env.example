# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/endelave-forecast

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# OpenWeather API Configuration
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_CITY=Endelave
OPENWEATHER_COUNTRY=DK
OPENWEATHER_LAT=55.75
OPENWEATHER_LON=10.27

# Google Calendar API Configuration (Optional)
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password
EMAIL_FROM=noreply@endelave.dk
EMAIL_TO=manager@endelave.dk

# Cron Schedule (default: 4 AM daily)
CRON_SCHEDULE=0 4 * * *

# Ferry Configuration (Manual/Mock)
FERRY_API_ENABLED=false
FERRY_DEFAULT_CAPACITY=100

# Danish Holiday API (Optional)
HOLIDAY_API_URL=https://api.dawa.aws.dk/
